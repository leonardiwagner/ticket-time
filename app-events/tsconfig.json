{
  "compilerOptions": {
    "target": "ES2022",
    "module": "NodeNext",
    "moduleResolution": "NodeNext",
    "outDir": "dist",
    "rootDir": ".",
    "sourceMap": true,
    "strict": true,
    "skipLibCheck": true
  },
  "include": [
    "*.test.ts",
    "health.ts",
    "event-generator.ts",
    "grpc/**/*.ts",
    "logging/**/*.ts",
    "main.ts",
    "models/**/*.ts",
    "repository/**/*.ts"
  ]
}
